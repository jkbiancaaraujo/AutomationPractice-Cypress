# Copie este arquivo para ".env" (ja esta no .gitignore) e preencha com valores reais.
# Nunca versione o arquivo .env com credenciais reais.

# URL base da aplicacao sob teste
CYPRESS_BASE_URL=https://www.automationexercise.com

# Credenciais de um usuario de teste ja cadastrado no site (usado nos cenarios de login)
CYPRESS_USER_EMAIL=
CYPRESS_USER_PASSWORD=
CYPRESS_USER_NAME=
